{
  "name": "dsh-interview-coach",
  "version": "0.6.2",
  "description": "Interview coach for DeepSeek Harness: candidate Mock with resume memory and HUD, plus an evidence-first interviewer workspace.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "lib",
    "bank",
    "locale",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "screenshots.json"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasoncai0/dsh-interview-coach.git"
  },
  "homepage": "https://github.com/jasoncai0/dsh-interview-coach#readme",
  "bugs": {
    "url": "https://github.com/jasoncai0/dsh-interview-coach/issues"
  },
  "author": "jasoncai0",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "interview",
    "mock-interview",
    "agent"
  ]
}
